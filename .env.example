# ProofBridge — Environment Configuration Template
# For local development, copy this file to .env.local:
#   copy .env.example .env.local   (Windows)
#   cp .env.example .env.local     (macOS/Linux)

NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key
DATABASE_URL=postgresql://postgres.your-project-id:your-database-password@aws-0-region.pooler.supabase.com:5432/postgres
DEMO_MODE=true
ENABLE_AI_DRAFTS=false
